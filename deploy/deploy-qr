#!/usr/bin/env bash
set -euo pipefail

readonly incoming_dir=/srv/qr/incoming
readonly site_dir=/srv/qr/site

test -f "$incoming_dir/index.html"
test -f "$incoming_dir/dist/index.js"

if find "$incoming_dir" -type l -print -quit | grep -q .; then
  echo "Refusing a release containing symbolic links." >&2
  exit 1
fi

install -d -m 0755 "$site_dir"
rsync -rltD --delete "$incoming_dir/" "$site_dir/"
chown -R root:root "$site_dir"
find "$site_dir" -type d -exec chmod 0755 {} +
find "$site_dir" -type f -exec chmod 0644 {} +

cd /srv/qr
docker compose up -d --no-deps qr-web
docker exec qr-web wget -qO- http://127.0.0.1/ | grep -Fq "QR Generator"
